{
  "name": "ai-company-world-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI Company World 3D — V0.1 Foundation (React + TypeScript + Three.js + R3F + Drei + Zustand + IndexedDB)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:backend": "node --import tsx --test tests/backend/*.test.ts"
  },
  "dependencies": {
    "@react-three/drei": "^9.120.4",
    "@react-three/fiber": "^8.17.10",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zod": "4.3.6",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.20.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "6.2.4",
    "tsx": "4.21.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
